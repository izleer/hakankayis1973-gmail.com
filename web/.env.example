# Sunucu tarafı API adresi (tarayıcıya sızmaz)
API_URL=http://127.0.0.1:4000

# Google AdSense (isteğe bağlı).
# Yayıncı kimliği ca-pub-... biçiminde tanımlanmazsa reklam alanları nötr bir
# yer tutucu olarak görünür ve üçüncü taraf isteği oluşmaz. Reklam birimi
# kimlikleri AdSense panelindeki "Reklam birimleri" ekranından alınır.
# ADSENSE_CLIENT=ca-pub-0000000000000000
# ADSENSE_SLOT_HOME=0000000000
# ADSENSE_SLOT_ASSETS=0000000000
# ADSENSE_SLOT_ASSET_DETAIL=0000000000
# ADSENSE_SLOT_GROUPS=0000000000
# ADSENSE_SLOT_FRIENDS=0000000000
# ADSENSE_SLOT_ENTRY=0000000000
# ADSENSE_SLOT_PROFILE=0000000000
