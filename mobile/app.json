{
  "expo": {
    "name": "izleer",
    "slug": "izleer-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "izleer",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.izleer.mobile"
    },
    "android": {
      "package": "app.izleer.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F1E6"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "izleer, varlık fotoğraflarını arşivine eklemek için galerine erişir.",
          "cameraPermission": "izleer, varlık fotoğrafı çekmek için kamerayı kullanır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appVersion": "0.1.0",
      "backupFormatVersion": 1
    }
  }
}
