# Terraform değişkenleri — bu dosyayı terraform.tfvars olarak kopyalayıp doldurun.
# Şifreyi tercihen TF_VAR_db_password ortam değişkeniyle verin.

ssh_host             = "203.0.113.10"
ssh_user             = "deploy"
ssh_port             = 22
ssh_private_key_path = "~/.ssh/id_ed25519"

domain     = "vh.example.com"
acme_email = "admin@example.com"

image_tag = "1.0.0"

db_name      = "varlik_hafizasi"
db_user      = "vh_app"
db_password  = "degistirin-uzun-rastgele-sifre"
database_ssl = false

session_ttl_days = 30
max_upload_mb    = 10

storage_driver = "local"

