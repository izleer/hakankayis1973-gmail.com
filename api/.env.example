# API
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
PUBLIC_API_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://vh_app:guclu-bir-sifre@127.0.0.1:5432/varlik_hafizasi
DATABASE_SSL=false
# Havuzdaki en fazla bağlantı. Supabase gibi yönetilen sunucularda küçük tutun.
DATABASE_POOL_MAX=10
# Migration/seed için ayrı adres (boşsa DATABASE_URL kullanılır).
# Supabase transaction pooler (6543) DDL ve advisory lock desteklemez;
# burada doğrudan (db.<proje>.supabase.co:5432) veya session pooler (5432) verin.
DATABASE_MIGRATION_URL=

# Supabase (yönetilen PostgreSQL) örneği:
# DATABASE_URL=postgresql://postgres.<proje>:<sifre>@aws-0-<bolge>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_MIGRATION_URL=postgresql://postgres.<proje>:<sifre>@aws-0-<bolge>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# Web istemcisi (virgülle ayrılır)
CORS_ORIGINS=http://localhost:3000

# Oturum
SESSION_TTL_DAYS=30

# Medya: local | s3
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# S3 / MinIO (STORAGE_DRIVER=s3 iken)
S3_REGION=eu-central-1
S3_BUCKET=varlik-hafizasi-media
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Meta (Facebook / Instagram) içerik paylaşımı
# Meta for Developers > Uygulamanız > Ayarlar > Temel
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# OAuth dönüş adresi; Meta konsolunda aynı adres eklenmeli.
META_REDIRECT_URI=http://localhost:4000/v1/social/callback
# Sayfa jetonlarını şifrelemek için en az 16 karakterlik rastgele anahtar.
SOCIAL_TOKEN_KEY=
# Bağlantı sonrası dönülecek web adresi (varsayılan: CORS_ORIGINS[0]/ayarlar/sosyal)
SOCIAL_WEB_RETURN_URL=http://localhost:3000/ayarlar/sosyal
# Instagram API'si medyayı herkese açık HTTPS adresinden indirir.
# Yerel depolamada bu adres ayarlanmazsa Instagram paylaşımı kapalı kalır.
MEDIA_PUBLIC_BASE_URL=
