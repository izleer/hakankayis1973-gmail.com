# API
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
PUBLIC_API_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://vh_app:guclu-bir-sifre@127.0.0.1:5432/varlik_hafizasi
DATABASE_SSL=false
# Havuzdaki en fazla bağlantı. Supabase gibi yönetilen sunucularda küçük tutun.
DATABASE_POOL_MAX=10
# Migration/seed için ayrı adres (boşsa DATABASE_URL kullanılır).
# Supabase transaction pooler (6543) DDL ve advisory lock desteklemez;
# burada doğrudan (db.<proje>.supabase.co:5432) veya session pooler (5432) verin.
DATABASE_MIGRATION_URL=

# Supabase (yönetilen PostgreSQL) örneği:
# DATABASE_URL=postgresql://postgres.<proje>:<sifre>@aws-0-<bolge>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_MIGRATION_URL=postgresql://postgres.<proje>:<sifre>@aws-0-<bolge>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# Web istemcisi (virgülle ayrılır)
CORS_ORIGINS=http://localhost:3000

# Oturum
SESSION_TTL_DAYS=30

# Medya: local | s3
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# S3 / MinIO (STORAGE_DRIVER=s3 iken)
S3_REGION=eu-central-1
S3_BUCKET=varlik-hafizasi-media
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Supabase Storage (S3 uyumlu) örneği — STORAGE_DRIVER=s3 iken:
# Dashboard > Storage > S3 Configuration sayfasından alınır.
# Access keys RLS'yi bypass eder; yalnızca sunucu tarafında kullanın, istemciye sızmamalı.
# S3_ENDPOINT=https://<proje-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=eu-central-1            (proje bölgesi)
# S3_BUCKET=varlik-hafizasi-media   (Storage'da oluşturduğunuz bucket adı)
# S3_FORCE_PATH_STYLE=true          (Supabase path-style gerektirir)
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# Yerel medyayı bu kovaya taşımak için: npm run storage:sync

# Meta (Facebook / Instagram) içerik paylaşımı
# Meta for Developers > Uygulamanız > Ayarlar > Temel
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# OAuth dönüş adresi; Meta konsolunda aynı adres eklenmeli.
META_REDIRECT_URI=http://localhost:4000/v1/social/callback
# Sayfa jetonlarını şifrelemek için en az 16 karakterlik rastgele anahtar.
SOCIAL_TOKEN_KEY=
# Bağlantı sonrası dönülecek web adresi (varsayılan: CORS_ORIGINS[0]/ayarlar/sosyal)
SOCIAL_WEB_RETURN_URL=http://localhost:3000/ayarlar/sosyal
# Instagram API'si medyayı herkese açık HTTPS adresinden indirir.
# Yerel depolamada bu adres ayarlanmazsa Instagram paylaşımı kapalı kalır.
MEDIA_PUBLIC_BASE_URL=

# --- Mağaza abonelikleri (Aşama 3) -----------------------------------------
# Çevrimdışı yetki toleransı (gün). Süre dolunca yerel veri silinmez.
BILLING_OFFLINE_GRACE_DAYS=7
# Mağaza konsolundaki ürün kimlikleri farklıysa tam listeyi JSON olarak verin:
# BILLING_PRODUCTS_JSON=[{"store":"google","productId":"izleer_premium_yearly","plan":"premium"}]
BILLING_PRODUCTS_JSON=

# Google Play: hizmet hesabı JSON'u (tek satır) veya dosya yolu.
# Play Console > Ayarlar > API erişimi > Hizmet hesabı.
GOOGLE_PLAY_PACKAGE_NAME=app.izleer.mobile
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# Pub/Sub push: OIDC audience (üretimde önerilir) veya paylaşılan sır.
GOOGLE_PLAY_WEBHOOK_AUDIENCE=
GOOGLE_PLAY_WEBHOOK_SECRET=

# Apple App Store Server API.
# App Store Connect > Kullanıcılar ve Erişim > Entegrasyonlar > App Store Server API.
APPLE_BUNDLE_ID=app.izleer.mobile
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# .p8 dosyasının içeriği; satır sonları \n olarak da verilebilir.
APPLE_PRIVATE_KEY=
# İsteğe bağlı: Apple kök sertifikasını ağdan çekmek yerine PEM olarak verin.
APPLE_ROOT_CA_PEM=
APPLE_ENVIRONMENT=production
