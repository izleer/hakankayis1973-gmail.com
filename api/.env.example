# API
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
PUBLIC_API_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://testagent_app:TestAgentApp2026!@127.0.0.1:5432/varlik_hafizasi
DATABASE_SSL=false

# Web istemcisi (virgülle ayrılır)
CORS_ORIGINS=http://localhost:3000

# Oturum
SESSION_TTL_DAYS=30

# Medya: local | s3
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# S3 / MinIO (STORAGE_DRIVER=s3 iken)
S3_REGION=eu-central-1
S3_BUCKET=varlik-hafizasi-media
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
