# Alan adı. DNS A/AAAA kaydı bu sunucuya yönlenmeli (80/443 açık olmalı).
DOMAIN=vh.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=varlik_hafizasi
POSTGRES_USER=vh_app
# URL'de özel karakter sorun çıkarır; en az 24 karakterlik URL-güvenli bir değer üretin:
#   openssl rand -hex 24
POSTGRES_PASSWORD=degistirin-uzun-rastgele-bir-sifre
DATABASE_SSL=false
# Havuzdaki en fazla bağlantı (Supabase'de küçük tutun).
DATABASE_POOL_MAX=10

# Supabase (yönetilen PostgreSQL) kullanılıyorsa yerel db servisi atlanır.
# Uygulama için transaction pooler (6543) veya session pooler (5432);
# migration/seed için doğrudan (db.<proje>.supabase.co:5432) veya session pooler (5432).
# DATABASE_URL=postgresql://postgres.<proje>:<sifre>@aws-0-<bolge>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_MIGRATION_URL=postgresql://postgres.<proje>:<sifre>@aws-0-<bolge>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_SSL=true

# Uygulama
IMAGE_TAG=1.0.0
SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=10

# Medya: local | s3
STORAGE_DRIVER=local
# S3 kullanılıyorsa (local yerine):
# STORAGE_DRIVER=s3
# S3_REGION=eu-central-1
# S3_BUCKET=varlik-hafizasi-media
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
